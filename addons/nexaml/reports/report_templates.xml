<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Actions -->
    <record id="action_report_sar" model="ir.actions.report">
        <field name="name">Suspicious Activity Report (SAR)</field>
        <field name="model">report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nexaml.report_sar_template</field>
        <field name="report_file">nexaml.report_sar_template</field>
        <field name="binding_model_id" ref="model_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_str" model="ir.actions.report">
        <field name="name">Suspicious Transaction Report (STR)</field>
        <field name="model">report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nexaml.report_str_template</field>
        <field name="report_file">nexaml.report_str_template</field>
        <field name="binding_model_id" ref="model_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_periodic" model="ir.actions.report">
        <field name="name">Periodic Compliance Summary</field>
        <field name="model">report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nexaml.report_periodic_template</field>
        <field name="report_file">nexaml.report_periodic_template</field>
        <field name="binding_model_id" ref="model_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_risk" model="ir.actions.report">
        <field name="name">Customer Risk Summary</field>
        <field name="model">report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nexaml.report_risk_template</field>
        <field name="report_file">nexaml.report_risk_template</field>
        <field name="binding_model_id" ref="model_report_wizard"/>
        <field name="binding_type">report</field>
    </record>

    <!-- SAR Report Template -->
    <template id="report_sar_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Suspicious Activity Report (SAR)</h2>

                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Report Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            </div>
                            <div class="col-6">
                                <strong>Period:</strong> <span t-esc="wizard.date_from"/> to <span t-esc="wizard.date_to"/>
                            </div>
                        </div>

                        <!-- Cases Section -->
                        <h4 class="mt-4">Cases</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Case Number</th>
                                    <th>Customer</th>
                                    <th>Type</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Opened Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="wizard.case_ids" t-as="case">
                                    <tr>
                                        <td><span t-field="case.name"/></td>
                                        <td><span t-field="case.partner_id.name"/></td>
                                        <td><span t-field="case.case_type"/></td>
                                        <td><span t-field="case.priority"/></td>
                                        <td><span t-field="case.state"/></td>
                                        <td><span t-field="case.opened_date"/></td>
                                    </tr>
                                    <!-- Narrative -->
                                    <t t-if="wizard.include_narrative and case.investigation_notes">
                                        <tr>
                                            <td colspan="6">
                                                <strong>Investigation Notes:</strong>
                                                <div t-raw="case.investigation_notes"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <!-- Transactions -->
                                    <t t-if="case.move_ids">
                                        <tr>
                                            <td colspan="6">
                                                <strong>Related Transactions:</strong>
                                                <table class="table table-sm table-bordered mt-2">
                                                    <thead>
                                                        <tr>
                                                            <th>Date</th>
                                                            <th>Reference</th>
                                                            <th>Amount</th>
                                                            <th>Risk Score</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <t t-foreach="case.move_ids" t-as="move">
                                                            <tr>
                                                                <td><span t-field="move.date"/></td>
                                                                <td><span t-field="move.name"/></td>
                                                                <td><span t-field="move.amount_total"/></td>
                                                                <td><span t-field="move.risk_score"/></td>
                                                            </tr>
                                                        </t>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- STR Report Template -->
    <template id="report_str_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Suspicious Transaction Report (STR)</h2>

                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Report Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            </div>
                            <div class="col-6">
                                <strong>Period:</strong> <span t-esc="wizard.date_from"/> to <span t-esc="wizard.date_to"/>
                            </div>
                        </div>

                        <!-- Transactions Section -->
                        <h4 class="mt-4">Suspicious Transactions</h4>
                        <t t-foreach="wizard.case_ids" t-as="case">
                            <div class="mt-3">
                                <h5>Case: <span t-field="case.name"/> - <span t-field="case.partner_id.name"/></h5>
                                <p><strong>Case Type:</strong> <span t-field="case.case_type"/></p>
                                <p><strong>Reason for Suspicion:</strong> <span t-field="case.description"/></p>

                                <table class="table table-sm table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Reference</th>
                                            <th>Type</th>
                                            <th>Amount</th>
                                            <th>Currency</th>
                                            <th>Risk Score</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="case.move_ids" t-as="move">
                                            <tr>
                                                <td><span t-field="move.date"/></td>
                                                <td><span t-field="move.name"/></td>
                                                <td><span t-field="move.move_type"/></td>
                                                <td><span t-field="move.amount_total"/></td>
                                                <td><span t-field="move.currency_id.name"/></td>
                                                <td><span t-field="move.risk_score"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>

                                <t t-if="wizard.include_narrative and case.investigation_notes">
                                    <div class="mt-2">
                                        <strong>Investigation Notes:</strong>
                                        <div t-raw="case.investigation_notes"/>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Periodic Compliance Summary Template -->
    <template id="report_periodic_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Periodic Compliance Summary</h2>

                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Report Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            </div>
                            <div class="col-6">
                                <strong>Period:</strong> <span t-esc="wizard.date_from"/> to <span t-esc="wizard.date_to"/>
                            </div>
                        </div>

                        <!-- Summary Statistics -->
                        <t t-set="cases" t-value="request.env['aml.case'].search([('opened_date', '>=', wizard.date_from), ('opened_date', '&lt;=', wizard.date_to)])"/>
                        <t t-set="alerts" t-value="request.env['aml.alert'].search([('alert_date', '>=', wizard.date_from), ('alert_date', '&lt;=', wizard.date_to)])"/>
                        <t t-set="screenings" t-value="request.env['aml.screening'].search([('screening_date', '>=', wizard.date_from), ('screening_date', '&lt;=', wizard.date_to)])"/>
                        <t t-set="high_risk_partners" t-value="request.env['res.partner'].search([('risk_level', '=', 'high'), ('customer_rank', '>', 0)])"/>

                        <h4 class="mt-4">Summary</h4>
                        <div class="row">
                            <div class="col-3">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 t-esc="len(cases)"/>
                                        <p>Cases Opened</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 t-esc="len(alerts)"/>
                                        <p>Alerts Generated</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 t-esc="len(screenings)"/>
                                        <p>Screenings Performed</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-3">
                                <div class="card">
                                    <div class="card-body text-center">
                                        <h3 t-esc="len(high_risk_partners)"/>
                                        <p>High Risk Customers</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Cases by State -->
                        <h4 class="mt-4">Cases by State</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>State</th>
                                    <th>Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="['open', 'investigating', 'review', 'resolved', 'closed']" t-as="state">
                                    <tr>
                                        <td><span t-esc="state.title()"/></td>
                                        <td><span t-esc="len(cases.filtered(lambda c: c.state == state))"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Alerts by Severity -->
                        <h4 class="mt-4">Alerts by Severity</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Severity</th>
                                    <th>Count</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="['low', 'medium', 'high', 'critical']" t-as="severity">
                                    <tr>
                                        <td><span t-esc="severity.title()"/></td>
                                        <td><span t-esc="len(alerts.filtered(lambda a: a.severity == severity))"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Customer Risk Summary Template -->
    <template id="report_risk_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">Customer Risk Summary</h2>

                        <div class="row mt-3">
                            <div class="col-12">
                                <strong>Report Date:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                            </div>
                        </div>

                        <t t-set="partners" t-value="wizard.partner_ids if wizard.partner_ids else request.env['res.partner'].search([('is_company', '=', True), ('customer_rank', '>', 0)])"/>

                        <h4 class="mt-4">Customer Risk Assessment</h4>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Customer</th>
                                    <th>Risk Level</th>
                                    <th>Inherent Risk</th>
                                    <th>Residual Risk</th>
                                    <th>EDD Required</th>
                                    <th>Last Assessment</th>
                                    <th>Next Review</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="partners" t-as="partner">
                                    <tr>
                                        <td><span t-field="partner.name"/></td>
                                        <td>
                                            <span t-field="partner.risk_level"
                                                  t-options='{"widget": "badge"}'
                                                  class="badge"
                                                  t-attf-class="badge-{{partner.risk_level == 'high' and 'danger' or partner.risk_level == 'medium' and 'warning' or 'success'}}"/>
                                        </td>
                                        <td><span t-esc="'%.2f' % partner.inherent_risk"/></td>
                                        <td><span t-esc="'%.2f' % partner.residual_risk"/></td>
                                        <td><span t-esc="'Yes' if partner.edd_required else 'No'"/></td>
                                        <td><span t-field="partner.last_assessment_date"/></td>
                                        <td><span t-field="partner.next_review_date"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
