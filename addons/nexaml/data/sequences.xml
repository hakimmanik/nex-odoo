<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for AML Case Numbers -->
        <record id="sequence_case" model="ir.sequence">
            <field name="name">AML Case Number</field>
            <field name="code">aml.case</field>
            <field name="prefix">AML-CASE-</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
