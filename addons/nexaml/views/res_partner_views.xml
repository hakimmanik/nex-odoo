<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Partner Form with NexAML Tab -->
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.aml</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add CRA score display after category_id -->
            <field name="category_id" position="after">
                <field name="risk_level" widget="badge"
                       decoration-success="risk_level == 'low'"
                       decoration-warning="risk_level == 'medium'"
                       decoration-danger="risk_level == 'high'"
                       string="Risk Level"/>
                <field name="residual_risk" string="Risk Score"/>
            </field>

            <!-- Add smart buttons for screenings and alerts -->
            <div name="button_box" position="inside">
                <button name="%(nexaml.action_screening)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-shield"
                        context="{'default_partner_id': id, 'search_default_partner_id': id}"
                        invisible="screening_count == 0">
                    <field name="screening_count" widget="statinfo" string="Screenings"/>
                </button>
                <button name="%(nexaml.action_alert)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-bell"
                        context="{'default_partner_id': id, 'search_default_partner_id': id}"
                        invisible="alert_count == 0">
                    <field name="alert_count" widget="statinfo" string="Alerts"/>
                </button>
            </div>

            <!-- Add NexAML tab -->
            <notebook position="inside">
                <page string="NexAML" name="nexaml">

                    <!-- Compliance Flags (Top Section) -->
                    <div class="alert alert-info" role="alert" invisible="not pep_status and sanctions_status == 'clear' and not kyc_expired and not on_watch_list">
                        <strong>Compliance Alerts:</strong>
                        <div>
                            <span invisible="not pep_status" class="badge badge-warning" style="margin-right: 5px;">
                                <i class="fa fa-exclamation-triangle"/> PEP
                            </span>
                            <span invisible="sanctions_status != 'match'" class="badge badge-danger" style="margin-right: 5px;">
                                <i class="fa fa-ban"/> Sanctioned
                            </span>
                            <span invisible="not kyc_expired" class="badge badge-warning" style="margin-right: 5px;">
                                <i class="fa fa-clock-o"/> KYC Expired
                            </span>
                            <span invisible="not on_watch_list" class="badge badge-warning" style="margin-right: 5px;">
                                <i class="fa fa-eye"/> Watch List
                            </span>
                        </div>
                    </div>

                    <!-- Basic Information Section -->
                    <separator string="Basic Information" colspan="4"/>
                    <group name="basic_information">
                        <group>
                            <field name="is_company" invisible="1"/>
                            <field name="customer_rank" invisible="1"/>
                            <field name="company_type"/>
                            <field name="create_date" readonly="1"/>
                            <field name="write_date" readonly="1"/>
                            <field name="vat" invisible="company_type == 'person'"/>
                        </group>
                        <group>
                            <field name="screening_count" readonly="1"/>
                            <field name="last_screening_date" readonly="1"/>
                            <field name="country_id" invisible="company_type == 'company'"/>
                        </group>
                    </group>

                    <!-- Employment & Financial (for individuals only) -->
                    <separator string="Employment &amp; Financial Information" colspan="4" invisible="company_type == 'company'"/>
                    <group name="employment_financial" invisible="company_type == 'company'">
                        <group>
                            <field name="occupation"/>
                            <field name="employer_name"/>
                            <field name="employer_address"/>
                        </group>
                        <group>
                            <field name="source_of_funds"/>
                            <field name="source_of_funds_other" invisible="source_of_funds != 'other'"/>
                            <field name="annual_income_range"/>
                        </group>
                    </group>

                    <!-- Risk Assessment Section -->
                    <separator string="Risk Assessment" colspan="4"/>
                    <!-- Summary Section -->
                    <group name="summary_section">
                        <group string="Risk Summary" colspan="2">
                            <group>
                                <field name="risk_level" widget="badge"
                                       decoration-success="risk_level == 'low'"
                                       decoration-warning="risk_level == 'medium'"
                                       decoration-danger="risk_level == 'high'"/>
                                <field name="inherent_risk" string="Inherent Risk (1.0-3.0)"/>
                                <field name="residual_risk" string="Residual Risk (1.0-3.0)"/>
                            </group>
                            <group>
                                <field name="edd_required" widget="boolean_toggle" string="EDD Required"/>
                                <field name="pep_status" widget="boolean_toggle" string="PEP Status"/>
                                <field name="last_assessment_date"/>
                                <field name="next_review_date"/>
                            </group>
                        </group>
                    </group>

                    <!-- Actions -->
                    <div class="oe_button_box" name="nexaml_actions" style="margin: 10px 0;">
                        <button name="action_assess_risk"
                                string="Calculate Risk"
                                type="object"
                                class="btn-primary"
                                icon="fa-calculator"
                                style="margin-right: 5px;"/>
                        <button name="action_screen_sanctions"
                                string="Screen for Sanctions"
                                type="object"
                                class="btn-secondary"
                                icon="fa-search"/>
                    </div>

                    <!-- Risk Component Visualization -->
                    <group string="Risk Components">
                        <group>
                            <label for="customer_risk" string="Customer (30%)"/>
                            <div>
                                <field name="customer_risk" widget="badge" nolabel="1"
                                       decoration-success="customer_risk &lt;= 1.6"
                                       decoration-warning="customer_risk &gt; 1.6 and customer_risk &lt;= 2.3"
                                       decoration-danger="customer_risk &gt; 2.3"
                                       style="width: 100%; height: 24px; border-radius: 4px; display: block; text-align: center; line-height: 24px;"/>
                            </div>
                        </group>
                        <group>
                            <label for="geography_risk" string="Geography (20%)"/>
                            <div>
                                <field name="geography_risk" widget="badge" nolabel="1"
                                       decoration-success="geography_risk &lt;= 1.6"
                                       decoration-warning="geography_risk &gt; 1.6 and geography_risk &lt;= 2.3"
                                       decoration-danger="geography_risk &gt; 2.3"
                                       style="width: 100%; height: 24px; border-radius: 4px; display: block; text-align: center; line-height: 24px;"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group>
                            <label for="product_risk" string="Product (30%)"/>
                            <div>
                                <field name="product_risk" widget="badge" nolabel="1"
                                       decoration-success="product_risk &lt;= 1.6"
                                       decoration-warning="product_risk &gt; 1.6 and product_risk &lt;= 2.3"
                                       decoration-danger="product_risk &gt; 2.3"
                                       style="width: 100%; height: 24px; border-radius: 4px; display: block; text-align: center; line-height: 24px;"/>
                            </div>
                        </group>
                        <group>
                            <label for="channel_risk" string="Channel (20%)"/>
                            <div>
                                <field name="channel_risk" widget="badge" nolabel="1"
                                       decoration-success="channel_risk &lt;= 1.6"
                                       decoration-warning="channel_risk &gt; 1.6 and channel_risk &lt;= 2.3"
                                       decoration-danger="channel_risk &gt; 2.3"
                                       style="width: 100%; height: 24px; border-radius: 4px; display: block; text-align: center; line-height: 24px;"/>
                            </div>
                        </group>
                    </group>

                    <group name="compliance_section">
                        <group string="Sanctions Screening">
                            <field name="sanctions_status" widget="badge"
                                   decoration-muted="sanctions_status == 'not_screened'"
                                   decoration-success="sanctions_status == 'clear'"
                                   decoration-danger="sanctions_status == 'match'"
                                   decoration-info="sanctions_status == 'pending'"/>
                            <field name="last_screening_date"/>
                            <field name="screening_count" readonly="1"/>
                        </group>
                        <group string="KYC &amp; Monitoring">
                            <field name="kyc_expiry_date"/>
                            <field name="kyc_expired" readonly="1" widget="boolean"
                                   decoration-danger="kyc_expired == True"/>
                            <field name="on_watch_list" widget="boolean_toggle"/>
                            <field name="watch_list_reason" invisible="not on_watch_list"
                                   placeholder="Reason for watch list placement..."/>
                        </group>
                    </group>

                    <!-- Related Parties (for companies) -->
                    <separator string="Related Parties (Directors, Shareholders, UBOs)" colspan="4" invisible="company_type == 'person'"/>
                    <field name="child_ids" invisible="company_type == 'person'" context="{'default_parent_id': id}">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="party_type"/>
                            <field name="ownership_percentage" optional="show" invisible="party_type not in ('shareholder', 'ubo')"/>
                            <field name="is_ubo" optional="show" invisible="party_type not in ('shareholder', 'ubo')"/>
                            <field name="pep_status" optional="show" widget="boolean_toggle"/>
                            <field name="sanctions_status" optional="show" widget="badge"
                                   decoration-success="sanctions_status == 'clear'"
                                   decoration-danger="sanctions_status == 'match'"/>
                            <field name="email" optional="hide"/>
                            <field name="phone" optional="hide"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="name"/>
                                        <field name="party_type"/>
                                        <field name="email"/>
                                        <field name="phone"/>
                                    </group>
                                    <group>
                                        <field name="ownership_percentage" invisible="party_type not in ('shareholder', 'ubo')"/>
                                        <field name="is_ubo" readonly="1" invisible="party_type not in ('shareholder', 'ubo')"/>
                                        <field name="pep_status"/>
                                        <field name="sanctions_status"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>

                    <!-- Documents & Attachments -->
                    <separator string="Documents &amp; Attachments" colspan="4"/>
                    <div class="text-center" style="padding: 20px;">
                        <button name="%(base.action_attachment)d" type="action"
                                string="Manage Documents"
                                class="btn-primary"
                                context="{'default_res_model': 'res.partner', 'default_res_id': id}"
                                icon="fa-folder-open"/>
                        <div class="text-muted" style="margin-top: 10px;">
                            <p>Click to view and manage customer documents</p>
                        </div>
                    </div>

                </page>

                <!-- Related Party Information (for contacts only) -->
                <page string="Related Party Info" name="related_party" invisible="not parent_id" groups="base.group_no_one">
                    <group string="Party Details">
                        <group>
                            <field name="party_type" widget="radio" options="{'horizontal': true}" optional="show"/>
                            <field name="ownership_percentage" invisible="party_type not in ('shareholder', 'ubo')" optional="show"/>
                            <field name="is_ubo" invisible="party_type not in ('shareholder', 'ubo')" optional="show"/>
                        </group>
                        <group>
                            <field name="pep_status" widget="boolean_toggle" optional="show"/>
                            <field name="sanctions_status" widget="badge"
                                   decoration-muted="sanctions_status == 'not_screened'"
                                   decoration-success="sanctions_status == 'clear'"
                                   decoration-danger="sanctions_status == 'match'"
                                   decoration-info="sanctions_status == 'pending'"
                                   optional="show"/>
                            <field name="last_screening_date" optional="show"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Extend Partner List/Tree View -->
    <record id="view_partner_tree_aml" model="ir.ui.view">
        <field name="name">res.partner.tree.aml</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="risk_level" widget="badge"
                       decoration-success="risk_level == 'low'"
                       decoration-warning="risk_level == 'medium'"
                       decoration-danger="risk_level == 'high'"
                       optional="show"/>
                <field name="residual_risk" optional="hide"/>
                <field name="edd_required" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Extend Product Template Form with AML Risk -->
    <record id="view_product_template_form_aml" model="ir.ui.view">
        <field name="name">product.template.form.aml</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Risk" name="risk">
                    <group>
                        <field name="risk_score" widget="radio"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Control Views -->
    <record id="view_control_tree" model="ir.ui.view">
        <field name="name">aml.control.tree</field>
        <field name="model">aml.control</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="mitigation_factor"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_control_form" model="ir.ui.view">
        <field name="name">aml.control.form</field>
        <field name="model">aml.control</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="mitigation_factor"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Applied To Customers" name="customers">
                            <field name="partner_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="risk_level" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_control" model="ir.actions.act_window">
        <field name="name">Controls</field>
        <field name="res_model">aml.control</field>
        <field name="view_mode">list,form</field>
        <field name="path">nexaml-control</field>
    </record>
</odoo>
