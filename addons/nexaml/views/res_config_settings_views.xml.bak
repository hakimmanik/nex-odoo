<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add NexAML Settings Section -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nexaml</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data_key="nexaml" string="NexAML">
                    <h2>NexAML - Anti-Money Laundering</h2>

                    <!-- Sanctions Screening -->
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="auto_screen_on_create"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="auto_screen_on_create"/>
                                <div class="text-muted">
                                    Automatically screen new customers against sanctions lists
                                </div>
                            </div>
                        </div>
                    </div>

                    <h3>Sanctions Screening Configuration</h3>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="yente_url" string="Yente API URL"/>
                                <field name="yente_url" placeholder="https://demo-yente.opensanctions.org"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="yente_api_key" string="API Key"/>
                                <field name="yente_api_key" password="True" placeholder="Optional"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="screening_threshold" string="Match Threshold (%)"/>
                                <field name="screening_threshold"/>
                                <div class="text-muted">
                                    Minimum match score (0-100) to flag as potential match
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Risk Assessment -->
                    <h3>Risk Assessment</h3>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="edd_threshold" string="EDD Requirement"/>
                                <field name="edd_threshold" widget="radio"/>
                                <div class="text-muted">
                                    Risk level that triggers Enhanced Due Diligence
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Transaction Monitoring -->
                    <h3>Transaction Monitoring</h3>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="monitor_invoices"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="monitor_invoices"/>
                                <div class="text-muted">
                                    Monitor customer invoices for suspicious patterns
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="monitor_payments"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="monitor_payments"/>
                                <div class="text-muted">
                                    Monitor payments for suspicious patterns
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
