<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment Method Form View -->
    <record id="view_account_payment_method_form" model="ir.ui.view">
        <field name="name">account.payment.method.form</field>
        <field name="model">account.payment.method</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Payment Method" edit="1">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="code" readonly="1"/>
                            <field name="payment_type" readonly="1"/>
                        </group>
                        <group>
                            <label for="risk_score" string="Risk Score"/>
                            <div>
                                <field name="risk_score" widget="radio" nolabel="1" force_save="1"/>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Payment Method Tree/List View -->
    <record id="view_account_payment_method_tree" model="ir.ui.view">
        <field name="name">account.payment.method.list</field>
        <field name="model">account.payment.method</field>
        <field name="arch" type="xml">
            <list string="Payment Method Risks" editable="bottom">
                <field name="name" readonly="1"/>
                <field name="code" readonly="1"/>
                <field name="payment_type" readonly="1"/>
                <field name="risk_score" string="Risk"
                       decoration-success="risk_score == '1'"
                       decoration-warning="risk_score == '2'"
                       decoration-danger="risk_score == '3'"/>
            </list>
        </field>
    </record>

    <!-- Payment Method Action -->
    <record id="action_account_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Method Risks</field>
        <field name="res_model">account.payment.method</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure payment methods with AML risk scores
            </p>
        </field>
    </record>

    <!-- Add menu item under Invoicing > Configuration -->
    <menuitem id="menu_account_payment_method_aml"
              name="Payment Method Risks"
              parent="account.menu_finance_configuration"
              action="action_account_payment_method"
              sequence="50"/>
</odoo>
