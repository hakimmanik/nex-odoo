<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dashboard Kanban View -->
    <record id="view_dashboard_kanban" model="ir.ui.view">
        <field name="name">aml.dashboard.kanban</field>
        <field name="model">aml.case</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard" create="0" edit="0" delete="0">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="container o_kanban_card_manage_pane o_kanban_record_has_image_fill">
                            <div class="row">
                                <!-- Active Alerts -->
                                <div class="col-md-3 col-sm-6 o_kanban_primary_left">
                                    <div class="o_kanban_card_content">
                                        <div class="o_kanban_primary_bottom">
                                            <a type="action" name="%(action_alert)d" context="{'search_default_filter_new': 1, 'search_default_filter_investigating': 1}">
                                                <div class="row">
                                                    <div class="col-8">
                                                        <span class="o_value">
                                                            <t t-esc="record.env['aml.alert'].search_count([('status', 'in', ['new', 'investigating'])])"/>
                                                        </span>
                                                        <span class="o_label">Active Alerts</span>
                                                    </div>
                                                    <div class="col-4 text-end">
                                                        <i class="fa fa-bell fa-3x text-warning" role="img" aria-label="Alerts" title="Alerts"/>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Open Cases -->
                                <div class="col-md-3 col-sm-6 o_kanban_primary_left">
                                    <div class="o_kanban_card_content">
                                        <div class="o_kanban_primary_bottom">
                                            <a type="action" name="%(action_case)d" context="{'search_default_filter_active': 1}">
                                                <div class="row">
                                                    <div class="col-8">
                                                        <span class="o_value">
                                                            <t t-esc="record.env['aml.case'].search_count([('state', 'not in', ['closed', 'resolved'])])"/>
                                                        </span>
                                                        <span class="o_label">Open Cases</span>
                                                    </div>
                                                    <div class="col-4 text-end">
                                                        <i class="fa fa-folder-open fa-3x text-primary" role="img" aria-label="Cases" title="Cases"/>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- High Risk Customers -->
                                <div class="col-md-3 col-sm-6 o_kanban_primary_left">
                                    <div class="o_kanban_card_content">
                                        <div class="o_kanban_primary_bottom">
                                            <a type="action" name="%(action_partner_high_risk)d">
                                                <div class="row">
                                                    <div class="col-8">
                                                        <span class="o_value">
                                                            <t t-esc="record.env['res.partner'].search_count([('risk_level', '=', 'high')])"/>
                                                        </span>
                                                        <span class="o_label">High Risk Customers</span>
                                                    </div>
                                                    <div class="col-4 text-end">
                                                        <i class="fa fa-exclamation-triangle fa-3x text-danger" role="img" aria-label="High Risk" title="High Risk"/>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <!-- Recent Screenings -->
                                <div class="col-md-3 col-sm-6 o_kanban_primary_left">
                                    <div class="o_kanban_card_content">
                                        <div class="o_kanban_primary_bottom">
                                            <a type="action" name="%(action_screening)d">
                                                <div class="row">
                                                    <div class="col-8">
                                                        <span class="o_value">
                                                            <t t-esc="record.env['aml.screening'].search_count([('screening_date', '&gt;=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))])"/>
                                                        </span>
                                                        <span class="o_label">Screenings (30d)</span>
                                                    </div>
                                                    <div class="col-4 text-end">
                                                        <i class="fa fa-search fa-3x text-info" role="img" aria-label="Screenings" title="Screenings"/>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Dashboard Action -->
    <record id="action_dashboard" model="ir.actions.act_window">
        <field name="name">AML Dashboard</field>
        <field name="res_model">aml.case</field>
        <field name="view_mode">kanban</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Welcome to NexAML</p>
            <p>Your Anti-Money Laundering compliance dashboard</p>
        </field>
    </record>

    <!-- High Risk Partners Action -->
    <record id="action_partner_high_risk" model="ir.actions.act_window">
        <field name="name">High Risk Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('risk_level', '=', 'high')]</field>
        <field name="context">{'search_default_risk_level': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No high-risk customers</p>
            <p>High-risk customers require Enhanced Due Diligence</p>
        </field>
    </record>

</odoo>
