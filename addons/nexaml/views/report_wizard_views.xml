<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Wizard Form View -->
    <record id="view_report_wizard_form" model="ir.ui.view">
        <field name="name">report.wizard.form</field>
        <field name="model">report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Report">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="output_format"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="include_narrative" invisible="report_type not in ['sar', 'str']"/>
                    </group>
                </group>
                <group string="Filters">
                    <field name="partner_ids" widget="many2many_tags" placeholder="All customers..."/>
                    <field name="case_ids" widget="many2many_tags"
                           invisible="report_type not in ['sar', 'str']"
                           placeholder="Select cases..."/>
                </group>
                <footer>
                    <button string="Generate Report" name="action_generate_report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Report Wizard Action -->
    <record id="action_report_wizard" model="ir.actions.act_window">
        <field name="name">Generate Report</field>
        <field name="res_model">report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
