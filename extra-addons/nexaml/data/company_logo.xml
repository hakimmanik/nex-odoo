<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Update default company logo -->
        <function model="res.company" name="write">
            <value eval="[ref('base.main_company')]"/>
            <value eval="{'logo': base64.b64encode(open(os.path.join(os.path.dirname(__file__), '..', 'static', 'description', 'icon.png'), 'rb').read())}"/>
        </function>
    </data>
</odoo>
