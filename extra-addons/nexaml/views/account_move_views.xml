<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_risk_preview" model="ir.ui.view">
        <field name="name">account.move.form.risk.preview</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="partner_risk_level" invisible="1"/>
                <field name="partner_inherent_risk" invisible="1"/>
                <field name="partner_residual_risk" invisible="1"/>
                <field name="risk_preview_html" invisible="1"/>
            </field>

            <notebook position="before">
                <div class="o_group" invisible="state == 'posted' or not partner_id">
                    <h3 style="margin: 10px 0; color: #856404;">
                        <i class="fa fa-exclamation-triangle"/> Transaction Risk Preview
                    </h3>
                    <field name="risk_preview_html" nolabel="1" widget="html" readonly="1"/>
                </div>
            </notebook>
        </field>
    </record>

</odoo>
