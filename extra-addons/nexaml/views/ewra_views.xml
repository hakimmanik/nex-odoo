<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- EWRA Run Views -->
    <record id="view_ewra_run_tree" model="ir.ui.view">
        <field name="name">nexaml.ewra.run.tree</field>
        <field name="model">nexaml.ewra.run</field>
        <field name="arch" type="xml">
            <list decoration-muted="status == 'archived'">
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="status" widget="badge"
                       decoration-muted="status == 'draft'"
                       decoration-info="status == 'in_progress'"
                       decoration-success="status == 'completed'"
                       decoration-warning="status == 'archived'"/>
                <field name="overall_risk_level" widget="badge"
                       decoration-success="overall_risk_level == 'low'"
                       decoration-warning="overall_risk_level == 'medium'"
                       decoration-danger="overall_risk_level == 'high'"/>
                <field name="overall_residual_score"/>
                <field name="approved_by"/>
            </list>
        </field>
    </record>

    <record id="view_ewra_run_form" model="ir.ui.view">
        <field name="name">nexaml.ewra.run.form</field>
        <field name="model">nexaml.ewra.run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_assessment" string="Start Assessment" type="object"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_complete" string="Complete Assessment" type="object"
                            class="btn-success" invisible="status != 'in_progress'"/>
                    <button name="action_generate_pdf" string="PDF Report" type="object"
                            class="btn-secondary" invisible="status != 'completed'" icon="fa-file-pdf-o"/>
                    <button name="action_generate_docx" string="DOCX Report" type="object"
                            class="btn-secondary" invisible="status != 'completed'" icon="fa-file-word-o"/>
                    <button name="action_archive" string="Archive" type="object"
                            invisible="status == 'archived'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="status != 'archived'"/>
                    <widget name="web_ribbon" title="Completed" bg_color="text-bg-success" invisible="status != 'completed'"/>

                    <div class="oe_title">
                        <label for="name" string="EWRA Name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Overall Risk Summary Card -->
                    <div class="alert alert-info" role="alert" invisible="status == 'draft'">
                        <h4>Overall Risk Assessment</h4>
                        <div class="row">
                            <div class="col-md-3">
                                <strong>Risk Level:</strong>
                                <field name="overall_risk_level" widget="badge"
                                       decoration-success="overall_risk_level == 'low'"
                                       decoration-warning="overall_risk_level == 'medium'"
                                       decoration-danger="overall_risk_level == 'high'"/>
                            </div>
                            <div class="col-md-3">
                                <strong>Inherent Risk:</strong> <field name="overall_inherent_score" readonly="1"/>
                            </div>
                            <div class="col-md-3">
                                <strong>Residual Risk:</strong> <field name="overall_residual_score" readonly="1"/>
                            </div>
                            <div class="col-md-3" invisible="not approved_by">
                                <strong>Approved By:</strong> <field name="approved_by" readonly="1"/>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group string="Assessment Period">
                            <field name="period_start" readonly="status != 'draft'"/>
                            <field name="period_end" readonly="status != 'draft'"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                        </group>
                        <group string="Approval">
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Risk Pillars" name="pillars">
                            <div class="alert alert-warning" role="alert" invisible="pillar_ids">
                                <p><strong>No risk pillars found.</strong></p>
                                <p>Click the button below to auto-populate pillars from customer data, or add them manually.</p>
                                <button name="action_initialize_pillars" string="Auto-Populate Pillars" type="object"
                                        class="btn-primary" icon="fa-magic"/>
                            </div>
                            <field name="pillar_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="pillar"/>
                                    <field name="low_pct"/>
                                    <field name="medium_pct"/>
                                    <field name="high_pct"/>
                                    <field name="inherent_score" readonly="1" decoration-success="inherent_score &lt; 1.7" decoration-warning="inherent_score &lt; 2.4" decoration-danger="inherent_score &gt;= 2.4"/>
                                    <field name="control_band"/>
                                    <field name="control_pct" readonly="1"/>
                                    <field name="residual_score" readonly="1" decoration-success="residual_score &lt; 1.7" decoration-warning="residual_score &lt; 2.4" decoration-danger="residual_score &gt;= 2.4"/>
                                    <field name="residual_label" widget="badge"/>
                                </list>
                                <form>
                                    <group>
                                        <group string="Pillar Information">
                                            <field name="pillar"/>
                                            <field name="sequence"/>
                                        </group>
                                        <group string="Results">
                                            <field name="inherent_score" readonly="1"/>
                                            <field name="inherent_label" readonly="1" widget="badge"/>
                                            <field name="residual_score" readonly="1"/>
                                            <field name="residual_label" readonly="1" widget="badge"/>
                                        </group>
                                    </group>
                                    <group string="Risk Distribution (%)">
                                        <group>
                                            <field name="low_pct"/>
                                            <field name="medium_pct"/>
                                            <field name="high_pct"/>
                                        </group>
                                        <group>
                                            <div class="text-muted">
                                                <p>Total must equal 100%</p>
                                            </div>
                                        </group>
                                    </group>
                                    <group string="Controls">
                                        <group>
                                            <field name="control_band" widget="radio"/>
                                            <field name="control_pct" readonly="1" invisible="control_band == 'custom'"/>
                                            <field name="custom_control_pct" invisible="control_band != 'custom'" placeholder="Enter percentage (0-100)"/>
                                            <field name="control_reason" placeholder="Reason for control effectiveness selection"/>
                                        </group>
                                        <group>
                                            <div class="text-muted">
                                                <p><strong>Control Band Presets:</strong></p>
                                                <ul>
                                                    <li>Weak: 30%</li>
                                                    <li>Adequate: 60%</li>
                                                    <li>Strong: 80%</li>
                                                    <li>Very Strong: 90%</li>
                                                    <li>Custom: Your own %</li>
                                                </ul>
                                            </div>
                                        </group>
                                    </group>
                                    <group string="Assessment Notes">
                                        <field name="notes" nolabel="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Narrative" name="narrative">
                            <group invisible="not narrative_id">
                                <group string="Foreword">
                                    <field name="narrative_id" invisible="1"/>
                                    <field name="narrative_id" readonly="1" invisible="not narrative_id" string="Edit Narrative" widget="statinfo"/>
                                </group>
                            </group>
                        </page>
                        <page string="Settings Snapshot" name="settings">
                            <group invisible="not settings_snapshot_id">
                                <group string="Risk Thresholds">
                                    <field name="settings_snapshot_id" invisible="1"/>
                                    <label for="settings_snapshot_id" string="Settings captured" invisible="not settings_snapshot_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>

    <record id="view_ewra_run_kanban" model="ir.ui.view">
        <field name="name">nexaml.ewra.run.kanban</field>
        <field name="model">nexaml.ewra.run</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="status"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="overall_risk_level"/>
                <field name="overall_residual_score"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><i class="fa fa-calendar" title="Period"/> <field name="period_start"/> - <field name="period_end"/></div>
                                    <div class="mt-1">
                                        <span class="badge" t-att-class="'badge-' + (record.overall_risk_level.raw_value === 'low' ? 'success' : record.overall_risk_level.raw_value === 'medium' ? 'warning' : 'danger')">
                                            <field name="overall_risk_level"/>
                                        </span>
                                        <span class="ms-2">Score: <field name="overall_residual_score"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_ewra_run_search" model="ir.ui.view">
        <field name="name">nexaml.ewra.run.search</field>
        <field name="model">nexaml.ewra.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <filter string="Draft" name="filter_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Completed" name="filter_completed" domain="[('status', '=', 'completed')]"/>
                <separator/>
                <filter string="Low Risk" name="filter_low" domain="[('overall_risk_level', '=', 'low')]"/>
                <filter string="Medium Risk" name="filter_medium" domain="[('overall_risk_level', '=', 'medium')]"/>
                <filter string="High Risk" name="filter_high" domain="[('overall_risk_level', '=', 'high')]"/>
                <group>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Risk Level" name="group_risk" context="{'group_by': 'overall_risk_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_ewra_run" model="ir.actions.act_window">
        <field name="name">EWRA Assessments</field>
        <field name="res_model">nexaml.ewra.run</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="path">nexaml-ewra</field>
        <field name="context">{'search_default_filter_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Enterprise-Wide Risk Assessment
            </p>
            <p>
                EWRA helps you assess AML/CFT risks across your organization.
            </p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_ewra"
              name="EWRA"
              parent="nexaml.menu_nexaml_root"
              sequence="30"/>

    <menuitem id="menu_ewra_assessments"
              name="Assessments"
              parent="menu_ewra"
              action="action_ewra_run"
              sequence="10"/>

    <!-- EWRA History View -->
    <record id="action_ewra_history" model="ir.actions.act_window">
        <field name="name">EWRA History</field>
        <field name="res_model">nexaml.ewra.run</field>
        <field name="view_mode">list,form</field>
        <field name="path">nexaml-ewra-history</field>
        <field name="domain">[]</field>
        <field name="context">{'search_default_filter_completed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No EWRA assessments found
            </p>
            <p>
                View historical EWRA assessments and their results.
            </p>
        </field>
    </record>

    <menuitem id="menu_ewra_history"
              name="History"
              parent="menu_ewra"
              action="action_ewra_history"
              sequence="20"/>

    <!-- EWRA Settings Views -->
    <record id="view_ewra_settings_list" model="ir.ui.view">
        <field name="name">nexaml.ewra.settings.list</field>
        <field name="model">nexaml.ewra.settings</field>
        <field name="arch" type="xml">
            <list string="EWRA Settings" create="true" edit="true" delete="true">
                <field name="company_id"/>
                <field name="risk_threshold_medium"/>
                <field name="risk_threshold_high"/>
                <field name="pillar_weight_customer"/>
                <field name="pillar_weight_geography"/>
                <field name="pillar_weight_products"/>
                <field name="pillar_weight_delivery"/>
            </list>
        </field>
    </record>

    <record id="view_ewra_settings_form" model="ir.ui.view">
        <field name="name">nexaml.ewra.settings.form</field>
        <field name="model">nexaml.ewra.settings</field>
        <field name="arch" type="xml">
            <form string="EWRA Settings">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="company_id" readonly="1"/></h1>
                    </div>

                    <notebook>
                        <page string="Risk Assessment Configuration" name="risk_config">
                            <group col="4">
                                <group string="Risk Thresholds" colspan="2">
                                    <field name="risk_threshold_medium" widget="percentage"/>
                                    <field name="risk_threshold_high" widget="percentage"/>
                                </group>
                                <group string="Control Settings" colspan="2">
                                    <field name="downgrade_threshold"/>
                                    <field name="cap_pct"/>
                                    <field name="default_control_band"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-3" role="alert">
                                <strong>Risk Classification:</strong><br/>
                                • Low: &lt; <field name="risk_threshold_medium" readonly="1" class="oe_inline"/> (Medium Threshold)<br/>
                                • Medium: <field name="risk_threshold_medium" readonly="1" class="oe_inline"/> to &lt; <field name="risk_threshold_high" readonly="1" class="oe_inline"/><br/>
                                • High: ≥ <field name="risk_threshold_high" readonly="1" class="oe_inline"/><br/><br/>
                                <strong>Control Settings:</strong><br/>
                                • If controls &lt; Downgrade Threshold: Residual = Inherent<br/>
                                • Controls capped at maximum % to ensure realism
                            </div>
                        </page>

                        <page string="Pillar Configuration" name="pillars">
                            <group col="4">
                                <group string="Pillar Weights (Must Total 100%)" colspan="2">
                                    <field name="pillar_weight_customer"/>
                                    <field name="pillar_weight_geography"/>
                                    <field name="pillar_weight_products"/>
                                    <field name="pillar_weight_delivery"/>
                                </group>
                                <group string="Enabled Pillars" colspan="2">
                                    <field name="include_customer_pillar"/>
                                    <field name="include_geography_pillar"/>
                                    <field name="include_products_pillar"/>
                                    <field name="include_delivery_pillar"/>
                                    <field name="supplier_enabled"/>
                                </group>
                            </group>
                            <div class="alert alert-warning mt-3" role="alert">
                                <strong>Note:</strong> Pillar weights must sum to exactly 100%. At least one pillar must be enabled.
                            </div>
                        </page>

                        <page string="EDD &amp; Screening" name="edd_screening">
                            <group col="4">
                                <group string="Enhanced Due Diligence" colspan="2">
                                    <field name="edd_threshold"/>
                                </group>
                                <group string="Sanctions Screening" colspan="2">
                                    <field name="sanctions_match_threshold"/>
                                    <field name="auto_screen_on_create"/>
                                    <field name="screening_frequency_days"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-3" role="alert">
                                <strong>EDD Threshold:</strong> Determines which risk levels trigger Enhanced Due Diligence requirements.<br/>
                                <strong>Screening:</strong> Configure automatic sanctions screening for new and existing customers.
                            </div>
                        </page>

                        <page string="Report &amp; Workflow" name="workflow">
                            <group col="4">
                                <group string="Automation Settings" colspan="2">
                                    <field name="auto_generate_narrative"/>
                                    <field name="enable_email_notifications"/>
                                    <field name="require_review"/>
                                </group>
                                <group colspan="2"/>
                            </group>
                            <div class="alert alert-info mt-3" role="alert">
                                <p><strong>Auto-Generate Narrative:</strong> Use AI to automatically generate risk narrative after EWRA completion</p>
                                <p><strong>Email Notifications:</strong> Send notifications for EWRA status changes and completion</p>
                                <p><strong>Require Review:</strong> Require management approval before finalizing EWRA</p>
                            </div>
                        </page>

                        <page string="Methodology Documentation" name="methodology">
                            <field name="methodology_notes" placeholder="Document your organization's EWRA methodology, including risk assessment criteria, data sources, control evaluation processes, and governance structure..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Simplified Methodology Form View -->
    <record id="view_ewra_settings_methodology_form" model="ir.ui.view">
        <field name="name">nexaml.ewra.settings.methodology.form</field>
        <field name="model">nexaml.ewra.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>EWRA Methodology Documentation</h1>
                    </div>
                    <group>
                        <field name="company_id" invisible="1"/>
                        <field name="methodology_notes" nolabel="1" placeholder="Document your organization's EWRA methodology..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ewra_settings" model="ir.actions.act_window">
        <field name="name">EWRA Settings</field>
        <field name="res_model">nexaml.ewra.settings</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_ewra_settings_form"/>
        <field name="path">nexaml-ewra-settings</field>
        <field name="context">{'default_company_id': allowed_company_ids[0] if allowed_company_ids else False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure EWRA Settings
            </p>
            <p>
                Set up risk thresholds, control parameters, and methodology documentation.
            </p>
        </field>
    </record>

    <menuitem id="menu_ewra_settings"
              name="Settings"
              parent="menu_ewra"
              action="action_ewra_settings"
              sequence="90"/>

    <!-- EWRA Methodology View -->
    <record id="view_ewra_methodology" model="ir.ui.view">
        <field name="name">EWRA Methodology</field>
        <field name="model">ir.ui.menu</field>
        <field name="arch" type="xml">
            <form string="EWRA Methodology" create="false" edit="false" delete="false">
                <sheet>
                    <div class="o_stat_card" style="max-width: 100%; padding: 2rem;">
                        <div style="max-width: 900px; margin: 0 auto; line-height: 1.6;">
                            <h1 style="font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; color: #1f2937;">
                                Enterprise-Wide Risk Assessment (EWRA) Methodology
                            </h1>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">1. Objective</h2>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;">
                                The Enterprise-Wide Risk Assessment (EWRA) constitutes a comprehensive evaluation framework designed to assess the organization's exposure to Money Laundering (ML), Terrorist Financing (TF), and Proliferation Financing (PF) risks across all operational business units and service lines.
                            </p>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;">
                                The fundamental purpose of this methodology is to establish a <strong>data-driven, repeatable, and fully auditable</strong> framework that ensures strict adherence to Financial Action Task Force (FATF) Recommendations, Certified Anti-Money Laundering Specialist (CAMS) industry standards, and applicable local regulatory requirements.
                            </p>
                            <p style="margin-bottom: 0.5rem; color: #4b5563;"><strong>The EWRA outcomes serve multiple critical organizational functions:</strong></p>
                            <ul style="margin-left: 1.5rem; margin-bottom: 1rem; color: #4b5563;">
                                <li><strong>Risk Identification and Quantification:</strong> Systematically identify and measure risk exposures across all material risk pillars</li>
                                <li><strong>Control Enhancement and Resource Optimization:</strong> Inform strategic decisions regarding control framework improvements and optimal allocation of compliance resources</li>
                                <li><strong>Governance and Oversight Support:</strong> Provide senior management and the Board of Directors with comprehensive, actionable intelligence</li>
                            </ul>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">2. Risk Pillars and Weightings</h2>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;">
                                The EWRA framework systematically evaluates risk exposure through a comprehensive multi-dimensional analysis structure. Each risk pillar represents a distinct dimension of the organization's AML/CFT risk profile:
                            </p>
                            <ul style="margin-left: 1.5rem; margin-bottom: 0.5rem; color: #4b5563;">
                                <li><strong>Customer Risk (40% Weight)</strong> – Risk arising from customer relationships, characteristics, and CRA assessment results</li>
                                <li><strong>Products &amp; Services Risk (25% Weight)</strong> – Risk inherent in the institution's product and service offerings</li>
                                <li><strong>Geography Risk (20% Weight)</strong> – Risk associated with jurisdictional exposure and geographic operations</li>
                                <li><strong>Delivery Channel Risk (15% Weight)</strong> – Risk related to customer onboarding and service delivery methods</li>
                                <li><strong>Supplier Risk (0% Weight)</strong> – Optional risk stemming from third-party relationships (currently not weighted)</li>
                            </ul>
                            <p style="margin-bottom: 1rem; color: #4b5563;"><strong>Risk Rating Scale:</strong> 1 = Low Risk, 2 = Medium Risk, 3 = High Risk</p>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">3. Data Integrity and Completeness</h2>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;"><strong>Mandatory Field Requirements:</strong></p>
                            <p style="margin-bottom: 0.5rem; color: #4b5563;">
                                The EWRA framework incorporates rigorous data quality controls to ensure assessment accuracy and reliability. All critical data elements utilized in risk scoring calculations are designated as mandatory fields.
                            </p>
                            <p style="margin-bottom: 0.5rem; color: #4b5563;"><strong>The following fields constitute mandatory data requirements:</strong></p>
                            <ul style="margin-left: 1.5rem; margin-bottom: 1rem; color: #4b5563;">
                                <li>Customer classification (individual or corporate entity)</li>
                                <li>Residency jurisdiction and nationality information</li>
                                <li>Country of incorporation and Ultimate Beneficial Owner (UBO) nationalities</li>
                                <li>Politically Exposed Person (PEP) status and sanctions screening results</li>
                                <li>Customer onboarding and service delivery channel</li>
                                <li>Associated product(s) and service(s) relationships</li>
                            </ul>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">4. Assessment Flow</h2>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;">
                                The EWRA methodology employs a structured, three-stage sequential assessment process:
                            </p>
                            <ol style="margin-left: 1.5rem; margin-bottom: 1rem; color: #4b5563;">
                                <li><strong>Inherent Risk Calculation</strong> – Automated system computation utilizing comprehensive customer and transaction data</li>
                                <li><strong>Control Effectiveness Assessment</strong> – User-directed evaluation of control framework strength</li>
                                <li><strong>Residual Risk Calculation</strong> – System-generated final risk determination based on pre-defined control logic</li>
                            </ol>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">5. Inherent Risk Assessment</h2>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;"><strong>Definition:</strong> Inherent Risk represents the level of ML/TF/PF exposure before applying mitigating controls.</p>
                            <p style="margin-bottom: 0.5rem; color: #4b5563;"><strong>Formula:</strong></p>
                            <p style="margin-bottom: 0.5rem; color: #4b5563; font-family: monospace; background: #f3f4f6; padding: 0.5rem; border-radius: 4px;">
                                (1 × Low% + 2 × Medium% + 3 × High%) ÷ 100
                            </p>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;">
                                Risk level thresholds are configurable via EWRA Settings. Default: 1.0 to &lt; 1.7 = Low, 1.7 to &lt; 2.4 = Medium, 2.4 to 3.0 = High
                            </p>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">6. Control Effectiveness</h2>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;"><strong>Definition:</strong> Control Effectiveness measures the strength of AML/CFT controls mitigating inherent risk.</p>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 1rem; font-size: 0.875rem;">
                                <thead>
                                    <tr style="background: #f3f4f6; border-bottom: 2px solid #e5e7eb;">
                                        <th style="padding: 0.5rem; text-align: left; font-weight: 600; color: #374151;">Control Level</th>
                                        <th style="padding: 0.5rem; text-align: left; font-weight: 600; color: #374151;">Value (%)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 0.5rem; color: #4b5563;">Weak</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">30%</td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 0.5rem; color: #4b5563;">Adequate</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">60%</td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 0.5rem; color: #4b5563;">Strong</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">80%</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 0.5rem; color: #4b5563;">Very Strong</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">90%</td>
                                    </tr>
                                </tbody>
                            </table>
                            <p style="margin-bottom: 1rem; color: #4b5563;">
                                <strong>Rules:</strong> Total control percentage capped at 70%. Minimum 35% required for one-level downgrade.
                            </p>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">7. Residual Risk Calculation</h2>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;"><strong>Definition:</strong> Residual Risk = Remaining exposure after applying control effectiveness.</p>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 1rem; font-size: 0.875rem;">
                                <thead>
                                    <tr style="background: #f3f4f6; border-bottom: 2px solid #e5e7eb;">
                                        <th style="padding: 0.5rem; text-align: left; font-weight: 600; color: #374151;">Condition</th>
                                        <th style="padding: 0.5rem; text-align: left; font-weight: 600; color: #374151;">Residual Result</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 0.5rem; color: #4b5563;">Control &lt; 35%</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">No downgrade (Residual = Inherent)</td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 0.5rem; color: #4b5563;">Control ≥ 35%</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">One-level downgrade (High→Medium, Medium→Low)</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 0.5rem; color: #4b5563;">Below Low</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">Not permitted (floor = Low)</td>
                                    </tr>
                                </tbody>
                            </table>
                            <p style="margin-bottom: 0.5rem; color: #4b5563;"><strong>Overrides:</strong></p>
                            <ul style="margin-left: 1.5rem; margin-bottom: 1rem; color: #4b5563;">
                                <li>Confirmed Sanctions = Decline / Block</li>
                                <li>Foreign or Senior PEP = Minimum High Residual</li>
                            </ul>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">8. Final Risk Rank</h2>
                            <p style="margin-bottom: 0.75rem; color: #4b5563;">
                                <strong>Definition:</strong> Organization's consolidated AML/CFT exposure after controls.
                            </p>
                            <p style="margin-bottom: 0.5rem; color: #4b5563;"><strong>Default Weights:</strong></p>
                            <ul style="margin-left: 1.5rem; margin-bottom: 1rem; color: #4b5563;">
                                <li>Customer – 40%</li>
                                <li>Products &amp; Services – 25%</li>
                                <li>Geography – 20%</li>
                                <li>Delivery Channel – 15%</li>
                            </ul>

                            <h2 style="font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: #374151;">9. Summary of Key Formulas</h2>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 1rem; font-size: 0.875rem;">
                                <thead>
                                    <tr style="background: #f3f4f6; border-bottom: 2px solid #e5e7eb;">
                                        <th style="padding: 0.5rem; text-align: left; font-weight: 600; color: #374151;">Stage</th>
                                        <th style="padding: 0.5rem; text-align: left; font-weight: 600; color: #374151;">Formula</th>
                                        <th style="padding: 0.5rem; text-align: left; font-weight: 600; color: #374151;">Source</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 0.5rem; color: #4b5563;">Inherent Risk</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">Weighted average (1–3)</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">System (Bot CRA)</td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 0.5rem; color: #4b5563;">Control Effectiveness</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">User-selected (30-90%)</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">User</td>
                                    </tr>
                                    <tr style="border-bottom: 1px solid #e5e7eb;">
                                        <td style="padding: 0.5rem; color: #4b5563;">Residual Risk</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">Inherent × (1 - effectiveness/100)</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">System</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 0.5rem; color: #4b5563;">Missing Data</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">Not applicable – mandatory fields enforced</td>
                                        <td style="padding: 0.5rem; color: #4b5563;">System Validation</td>
                                    </tr>
                                </tbody>
                            </table>

                            <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid #e5e7eb; text-align: center; color: #6b7280; font-size: 0.875rem;">
                                <em>Enterprise-Wide Risk Assessment (EWRA) - Powered by NexAML</em>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

